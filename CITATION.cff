    given-names: "Daniel"
    orcid: "https://orcid.org/0000-0001-8451-302X"
    affiliation: "Universidad del Valle, Cali, Colombia"
  - family-names: "Gutierrez de Piñerez Reyes"
    given-names: "Raúl Ernesto"
    orcid: "https://orcid.org/0000-0001-9941-6206"
    affiliation: "Universidad del Valle, Cali, Colombia"
keywords:
  - natural language processing
  - information retrieval
  - text analysis
  - multi-agent systems
  - bibliometrics
  - retrieval augmented generation
